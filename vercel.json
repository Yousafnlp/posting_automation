{
  "functions": {
    "api/cron.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 10 * * *" },
    { "path": "/api/cron", "schedule": "0 14 * * *" },
    { "path": "/api/cron?job=static", "schedule": "0 13 * * *" },
    { "path": "/api/cron?job=carousel", "schedule": "0 10 * * 2,6" }
  ]
}
